# Loaded by `npm run dev:service` (node --env-file). No secrets here; safe to commit.
LOG_LEVEL=debug
LOG_PRETTY=true
DB_PATH=data/orders.db
SEED_DB=true
# Order service
PORT=3001
HOST=127.0.0.1

# Order builder (separate process; talks to the order service over HTTP)
BUILDER_PORT=3000
BUILDER_HOST=127.0.0.1
ORDER_SERVICE_URL=http://127.0.0.1:3001
SHUTDOWN_TIMEOUT_MS=3000

# Re-read the pages and scripts on every request, so an edit shows up on refresh. The dev watcher only
# restarts for changed code, not for changed pages, so without this the browser gets stale pages.
UI_RELOAD=true
